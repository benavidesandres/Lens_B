# Puerto y host del servidor. 0.0.0.0 permite conectarse desde el teléfono en la misma red.
PORT=8787
HOST=0.0.0.0

# Clave de la API de Anthropic (Claude). Opcional: sin ella, las rutas se generan
# con el planificador local en lugar de con IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento del modelo: low | medium | high
ANTHROPIC_EFFORT=low

# Alternativa a Claude: clave de Groq (https://console.groq.com). Solo se usa si
# ANTHROPIC_API_KEY está vacía.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Maps Platform: lugares (Places API New), fotos, precios y trazado a pie
# (Routes API). Opcional: sin clave se usan OpenStreetMap y Wikipedia.
# Restricciones recomendadas para esta clave:
#   - Aplicación: ninguna en desarrollo; "Direcciones IP" con la IP del servidor en producción.
#     NO la restrinjas a "Apps de Android": la usa el servidor, no el teléfono.
#   - API: solo "Places API (New)" y "Routes API".
GOOGLE_MAPS_API_KEY=

# Idioma de Wikipedia y de los resultados de Google usado para historias y descripciones.
WIKIPEDIA_LANG=es

# Servidores Overpass (OpenStreetMap) separados por coma, en orden de preferencia.
# Los públicos se saturan a menudo; en producción conviene una instancia propia.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Wikimedia y Overpass piden identificar la aplicación con un contacto.
HTTP_USER_AGENT=LENS/0.1 (+https://github.com/your-org/lens)

# Orígenes permitidos para CORS (separados por coma) o * en desarrollo.
CORS_ORIGIN=*

# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info
