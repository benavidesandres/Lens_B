# Opcional: URL del servidor de LENS. Si no se define, en desarrollo se deduce
# automaticamente la IP del equipo a partir de Metro.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8787

# Opcional, solo para compilar la app con EAS Build (Expo Go no la necesita):
# clave de "Maps SDK for Android", restringida a Apps de Android con el
# paquete com.lens.app y la huella SHA-1 que muestra `eas credentials`.
# GOOGLE_MAPS_ANDROID_API_KEY=

# Supabase (inicio de sesión). Ambos valores están en el panel del proyecto.
# La clave publicable puede ir en la app; nunca pongas aquí la clave secreta.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
